# Copy to router.env and adjust. router.env is gitignored.
#
# Bonjour names can stay cached while a host is absent. The router's callback
# bounds HTTP connection establishment separately from model-loading time.
#
# imac-thunder -> 192.168.2.2 (Thunderbolt), 192.168.1.37 (LAN)
# mini-thunder -> 192.168.2.1 (Thunderbolt), 192.168.1.26 (LAN)

M4PRO_BASE=http://FM7XXRXT4V.local:8080/v1
M2PRO_BASE=http://mini-thunder:8080/v1

# Key the router sends UPSTREAM to llama-swap. llama-swap does not require one
# by default; it only has to be non-empty for the OpenAI client.
LOCAL_KEY=sk-local

# Key CLIENTS must send to the router. LiteLLM refuses to start without one.
# install-router.sh generates a random value here if it has to create the file.
LITELLM_MASTER_KEY=sk-change-me

# Port the router listens on.
# ROUTER_PORT=4000

# HTTP connection budget; independent of cold model load / read budgets.
# HUB_CONNECT_TIMEOUT=3
